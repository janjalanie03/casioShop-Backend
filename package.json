    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5",
    "@google/genai": "^1.30.0"
  },
  "devDependencies": {}
}
